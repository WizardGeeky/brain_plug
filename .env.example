# ==============================================================================
# BRAIN PLUG - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure the properties below.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application & Base URLs
# ------------------------------------------------------------------------------
APP_URL=""
NEXT_PUBLIC_APP_URL=""
WIDGET_BASE_URL=""

# ------------------------------------------------------------------------------
# Database Connection (PostgreSQL / Supabase / Neon / Local)
# ------------------------------------------------------------------------------
# Transaction-mode connection pooler URL (Used by Prisma Client in production)
DATABASE_URL=""

# Direct session-mode connection URL (Used for Prisma migrations & schema pushes)
DIRECT_URL=""

# ------------------------------------------------------------------------------
# Google Gemini AI API Configuration
# (Can also be set dynamically via Super Admin Dashboard > Platform Settings)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# Object Storage Configuration (Cloudinary / Local)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="" # "cloudinary" | "local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER=""

# ------------------------------------------------------------------------------
# Authentication, JWT & Cryptographic Security
# ------------------------------------------------------------------------------
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRY="" # e.g. "3h"
AES_ENCRYPTION_KEY="" # 32-byte hex key for AES-256-GCM
OTP_EXPIRY_MINUTES="" # e.g. 5
MAX_OTP_ATTEMPTS="" # e.g. 5

# ------------------------------------------------------------------------------
# Default Super Admin Seed Configuration (npm run db:seed)
# ------------------------------------------------------------------------------
DEFAULT_ADMIN_FULL_NAME=""
DEFAULT_ADMIN_EMAIL=""
DEFAULT_ADMIN_MOBILE=""
DEFAULT_ADMIN_GENDER="" # "MALE" | "FEMALE" | "OTHER"
DEFAULT_ADMIN_LOCATION=""

# ------------------------------------------------------------------------------
# Transactional Email & SMTP Configuration
# ------------------------------------------------------------------------------
EMAIL_PROVIDER="" # "console" | "smtp" | "resend"
EMAIL_FROM=""
SMTP_FROM=""
SMTP_HOST=""
SMTP_PORT="" # e.g. 587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="" # "false" | "true"

# ------------------------------------------------------------------------------
# In-Memory Rate Limiting Parameters
# ------------------------------------------------------------------------------
RATE_LIMIT_LOGIN_MAX="" # e.g. 10
RATE_LIMIT_LOGIN_WINDOW_SEC="" # e.g. 60
RATE_LIMIT_CHAT_MAX="" # e.g. 60
RATE_LIMIT_CHAT_WINDOW_SEC="" # e.g. 60
